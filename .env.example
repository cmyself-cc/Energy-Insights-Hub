# LLM API配置（必需）
# 支持OpenAI、DeepSeek、Anthropic等兼容OpenAI API的提供商
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4

# 搜索API配置（可选）
# Tavily搜索API
TAVILY_API_KEY=your_tavily_api_key_here

# Bocha搜索API
BOCHA_API_KEY=your_bocha_api_key_here

# 服务配置
PORT=3001
NODE_ENV=development

# 数据库配置
# DATABASE_PATH 未被代码读取（db.js 实际读 DATA_DIR / DB_PATH），保留本行仅作历史参考
# DATABASE_PATH=./data/energy_insights.db

# 微信MCP配置（可选，如果使用微信数据源）
# WECHAT_MCP_URL=http://localhost:3000/mcp

# 微信登录（开放平台网站应用；未就绪时本地用 mock 模式联调）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=https://eih.cmyself.cc/api/auth/wechat/callback
# 本地开发免微信：AUTH_DEV_MODE=wechat-mock（仅非 production 生效）
AUTH_DEV_MODE=
# 初始管理员 UnionID（首次登录直接成为 admin，免邀请码）
ADMIN_UNIONID=

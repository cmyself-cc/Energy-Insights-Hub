# Server
PORT=3001
NODE_ENV=development

# Database
DATA_DIR=./data
DB_PATH=./data/energy_insights.db

# LLM configuration for backend tracker
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_api_key_here

# Default language for generated insights
DEFAULT_LANGUAGE=zh

# Tracker schedule (cron expression, default 05:00 daily)
TRACKER_CRON=0 5 * * *
TZ=Asia/Shanghai
